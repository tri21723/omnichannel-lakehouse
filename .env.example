# Local development only. Copy to .env and fill credentials before starting services.
COMPOSE_PROJECT_NAME=omnichannel-lakehouse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=platform_admin
POSTGRES_PASSWORD=
POSTGRES_SOURCES_DB=sources
MINIO_ROOT_USER=platform_admin
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://minio:9000
AWS_DEFAULT_REGION=us-east-1
S3_RAW_BUCKET=raw
S3_LAKEHOUSE_BUCKET=lakehouse
S3_CHECKPOINT_BUCKET=checkpoints
# Database service credentials (generated by make env).
LAKEKEEPER_URI=http://lakekeeper:8181
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_SHUFFLE_PARTITIONS=16
AIRFLOW_UID=50000
AIRFLOW_PARALLELISM=1
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Batch/stream runtime versions remain pending ADR-0001 verification.

# Pinned core images; see ADR-0001.
POSTGRES_IMAGE=postgres:16.15-bookworm
MINIO_IMAGE=omnichannel/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=omnichannel/mc:RELEASE.2025-08-13T08-35-41Z
AIRFLOW_DB_PASSWORD=
LAKEKEEPER_DB_PASSWORD=
MLFLOW_DB_PASSWORD=
GENERATOR_DB_PASSWORD=
SPARK_READER_DB_PASSWORD=
SPARK_WRITER_DB_PASSWORD=
TRINO_RO_DB_PASSWORD=
DEBEZIUM_REPL_DB_PASSWORD=
GENERATOR_S3_ACCESS_KEY=generator_local
GENERATOR_S3_SECRET_KEY=
SPARK_S3_ACCESS_KEY=spark_local
SPARK_S3_SECRET_KEY=
TRINO_S3_ACCESS_KEY=trino_local
TRINO_S3_SECRET_KEY=
LAKEKEEPER_S3_ACCESS_KEY=lakekeeper_local
LAKEKEEPER_S3_SECRET_KEY=
# Phase 3; env-batch adds missing settings without rotating existing credentials.
LAKEKEEPER_IMAGE=quay.io/lakekeeper/catalog:v0.9.3
LAKEKEEPER_ENCRYPTION_KEY=
LAKEHOUSE_WAREHOUSE=local_lakehouse
