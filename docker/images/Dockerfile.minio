# Build the pinned upstream releases: public binary registries are unavailable.
FROM golang:1.24.7-alpine3.22 AS base
RUN apk add --no-cache git ca-certificates
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOMAXPROCS=2
WORKDIR /src

FROM base AS server-build
RUN git clone --depth 1 --branch RELEASE.2025-09-07T16-13-09Z https://github.com/minio/minio.git .
RUN go build -p 2 -trimpath -o /out/minio .

FROM base AS client-build
RUN git clone --depth 1 --branch RELEASE.2025-08-13T08-35-41Z https://github.com/minio/mc.git .
RUN go build -p 2 -trimpath -o /out/mc .

FROM alpine:3.22.2 AS server
RUN apk add --no-cache ca-certificates
COPY --from=server-build /out/minio /usr/local/bin/minio
COPY --from=server-build /src/LICENSE /licenses/minio-LICENSE
ENTRYPOINT ["minio"]

FROM alpine:3.22.2 AS client
RUN apk add --no-cache ca-certificates
COPY --from=client-build /out/mc /usr/local/bin/mc
COPY --from=client-build /src/LICENSE /licenses/mc-LICENSE
ENTRYPOINT ["mc"]
