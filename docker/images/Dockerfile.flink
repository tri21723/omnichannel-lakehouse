# Flink runtime with the stream jobs jar (ADR-0016). The build stage runs the JUnit tests.
ARG FLINK_IMAGE=flink:2.2.1-java17
FROM maven:3.9.16-eclipse-temurin-17 AS build
WORKDIR /build
COPY flink/jobs/pom.xml pom.xml
# Maven Central rate-limits shared CI IPs; the resolver retries 429/503 honouring Retry-After.
ENV MAVEN_OPTS="-Daether.connector.http.retryHandler.count=8"
RUN mvn -B -q dependency:go-offline
COPY flink/jobs/src src
RUN mvn -B -q package

FROM ${FLINK_IMAGE}
COPY --from=build /build/target/stream-jobs.jar /opt/flink/usrlib/stream-jobs.jar
