\set ON_ERROR_STOP on
\getenv role_password AIRFLOW_DB_PASSWORD
SELECT 'CREATE ROLE airflow LOGIN' WHERE NOT EXISTS (
    SELECT FROM pg_roles WHERE rolname = 'airflow'
) \gexec
ALTER ROLE airflow WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD :'role_password';
\getenv role_password LAKEKEEPER_DB_PASSWORD
SELECT 'CREATE ROLE lakekeeper LOGIN' WHERE NOT EXISTS (
    SELECT FROM pg_roles WHERE rolname = 'lakekeeper'
) \gexec
ALTER ROLE lakekeeper WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD :'role_password';
\getenv role_password MLFLOW_DB_PASSWORD
SELECT 'CREATE ROLE mlflow LOGIN' WHERE NOT EXISTS (
    SELECT FROM pg_roles WHERE rolname = 'mlflow'
) \gexec
ALTER ROLE mlflow WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD :'role_password';
\getenv role_password GENERATOR_DB_PASSWORD
SELECT 'CREATE ROLE generator LOGIN' WHERE NOT EXISTS (
    SELECT FROM pg_roles WHERE rolname = 'generator'
) \gexec
ALTER ROLE generator WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD :'role_password';
\getenv role_password SPARK_READER_DB_PASSWORD
SELECT 'CREATE ROLE spark_reader LOGIN' WHERE NOT EXISTS (
    SELECT FROM pg_roles WHERE rolname = 'spark_reader'
) \gexec
ALTER ROLE spark_reader WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD :'role_password';
\getenv role_password SPARK_WRITER_DB_PASSWORD
SELECT 'CREATE ROLE spark_writer LOGIN' WHERE NOT EXISTS (
    SELECT FROM pg_roles WHERE rolname = 'spark_writer'
) \gexec
ALTER ROLE spark_writer WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD :'role_password';
\getenv role_password TRINO_RO_DB_PASSWORD
SELECT 'CREATE ROLE trino_ro LOGIN' WHERE NOT EXISTS (
    SELECT FROM pg_roles WHERE rolname = 'trino_ro'
) \gexec
ALTER ROLE trino_ro WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD :'role_password';
\getenv role_password DEBEZIUM_REPL_DB_PASSWORD
SELECT 'CREATE ROLE debezium_repl LOGIN' WHERE NOT EXISTS (
    SELECT FROM pg_roles WHERE rolname = 'debezium_repl'
) \gexec
ALTER ROLE debezium_repl WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE REPLICATION PASSWORD :'role_password';
SELECT 'CREATE DATABASE sources' WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'sources') \gexec
REVOKE ALL ON DATABASE sources FROM PUBLIC;
SELECT 'CREATE DATABASE airflow OWNER airflow' WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'airflow') \gexec
REVOKE ALL ON DATABASE airflow FROM PUBLIC;
GRANT CONNECT, TEMPORARY ON DATABASE airflow TO airflow;
SELECT 'CREATE DATABASE lakekeeper OWNER lakekeeper' WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'lakekeeper') \gexec
REVOKE ALL ON DATABASE lakekeeper FROM PUBLIC;
GRANT CONNECT, TEMPORARY ON DATABASE lakekeeper TO lakekeeper;
SELECT 'CREATE DATABASE mlflow OWNER mlflow' WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'mlflow') \gexec
REVOKE ALL ON DATABASE mlflow FROM PUBLIC;
GRANT CONNECT, TEMPORARY ON DATABASE mlflow TO mlflow;
GRANT CONNECT ON DATABASE sources TO generator, spark_reader, spark_writer, trino_ro, debezium_repl;
